{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^charts/arr-stack/values\\.yaml$"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*image=(?<depName>[^\\s]+)\\s*\\n\\s*repository:\\s*[^\\s]+\\s*\\n\\s*tag:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge minor/patch image bumps tracked by customManagers",
      "matchManagers": [
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Automerge minor/patch app-template (Chart.yaml) bumps",
      "matchManagers": [
        "helmv3"
      ],
      "matchPackageNames": [
        "app-template"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Gate major bumps for manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "TEMP cap: qbit_manage 4.9.1 max qBittorrent 5.2.2 — remove when qbit_manage supports 5.2.3",
      "matchPackageNames": [
        "lscr.io/linuxserver/qbittorrent"
      ],
      "allowedVersions": "<=5.2.2"
    }
  ]
}
